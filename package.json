{
  "name": "lr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsx scripts/generate-sitemap.ts && npm run generate:sitemaps && tsc -b && npm run build:client && npm run build:server && npm run prerender && npx tsx scripts/sovereign-audit.ts",
    "generate:sitemaps": "node scripts/generate-sitemaps.js && node scripts/generate-shopping-feed.js",
    "build:client": "npm run generate:sitemaps && vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "npx tsx scripts/prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:ssg": "npm run build",
    "index": "node scripts/google-index.cjs",
    "harden:cf": "node scripts/cloudflare-harden.cjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
