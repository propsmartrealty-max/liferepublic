    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.17",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.13.2",
    "remark-gfm": "^4.0.1",
    "swiper": "^12.1.3",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^9.39.1",
